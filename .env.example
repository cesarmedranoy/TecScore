# ============================================================================
# TecScore — Variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo a `.env.local` y completa con tus valores reales.
# NUNCA commitees `.env.local` (ya está en .gitignore).
# ============================================================================

# ---------- AWS / DynamoDB ----------
# Para desarrollo LOCAL (Docker), deja DYNAMODB_ENDPOINT apuntando a localhost.
# Para PRODUCCIÓN (AWS real), deja DYNAMODB_ENDPOINT vacío o coméntalo.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://localhost:8000

# Prefijo de tablas para separar entornos en la misma cuenta AWS
# (ej: dev_Users, staging_Users, prod_Users)
TABLE_PREFIX=dev_

# ---------- Auth.js (NextAuth v5) ----------
# Genera con: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (se obtiene en console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL base de la app (para callbacks de OAuth)
AUTH_URL=http://localhost:3000

# ---------- Cache (Upstash Redis - se configura en Fase 7) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Real-time (Pusher - se configura en Fase 6) ----------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ---------- IA (Claude - se configura en Fase 7) ----------
ANTHROPIC_API_KEY=
